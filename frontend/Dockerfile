# Фронтенд — статика. Своего веб-сервера у него нет и не будет: файлы отдаёт
# общий Caddy, а лишний слой внутри контейнера — та самая болезнь Horse Bio,
# где до Django стоят три перекладывающих прокси.
#
# Поэтому образ не «работает», а один раз выкладывает собранные файлы в том,
# смонтированный и сюда, и в Caddy, после чего завершается.

FROM node:22-alpine AS build

WORKDIR /app

# npm ci ставит ровно то, что в package-lock.json: сборка на сервере даёт
# те же версии, что были проверены локально.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM alpine:3.21

COPY --from=build /app/dist /dist

# Старые файлы удаляются: без этого фрагменты предыдущей сборки остаются
# в томе навсегда, а имена у собранных ассетов хешированные — мусор копится
# с каждым деплоем.
CMD ["sh", "-c", "\
  if [ ! -d /target ]; then echo 'Том /target не смонтирован' >&2; exit 1; fi; \
  rm -rf /target/*; \
  cp -a /dist/. /target/; \
  echo 'Статика выложена:'; ls /target"]
