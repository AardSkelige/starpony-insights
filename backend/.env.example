# Скопируйте в backend/.env и заполните. Файл .env в репозиторий не попадает.

# Обязателен. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=False
LOG_LEVEL=INFO

# Через запятую, без схемы
ALLOWED_HOSTS=localhost,127.0.0.1
# Через запятую, СО схемой: https://insight.star-pony.ru
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=starpony
POSTGRES_USER=starpony
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# True, когда снаружи стоит Caddy и TLS заканчивается на нём
BEHIND_TLS_PROXY=False

# HSTS: включать осознанно и постепенно. 0 — выключен, 60 — проверка, 31536000 — год.
# До конца срока браузер не даст откатиться на HTTP.
SECURE_HSTS_SECONDS=0
