# Блок StarPony Insights для общего Caddyfile.
#
# Caddy на сервере один на два проекта, и его конфигурация живёт в
# /root/caddy/Caddyfile. Здесь — та часть, что относится к нашему домену:
# чтобы её можно было прочитать, не заходя на сервер, и восстановить,
# если конфигурация на сервере потеряется.
#
# Применение: вставить вместо блока-заглушки `respond`, затем
#   docker exec shared_caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec shared_caddy caddy reload   --config /etc/caddy/Caddyfile

insight.star-pony.ru {
	# HSTS не включаем: пока откат должен оставаться мгновенным.
	# Включать осознанно и постепенно — DESIGN.md здесь ни при чём,
	# см. docs/HTTPS-SETUP.md и правило про SECURE_HSTS_SECONDS.

	# API. Таймауты подняты: синхронизация с МойСкладом идёт минутами,
	# а прокси по умолчанию рвёт соединение куда раньше.
	handle /api/* {
		reverse_proxy starpony-backend:8000 {
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle /admin/* {
		reverse_proxy starpony-backend:8000
	}

	handle /healthz {
		reverse_proxy starpony-backend:8000
	}

	# Статика админки Django. Приставка своя, не /static/, — иначе она
	# столкнулась бы с файлами фронтенда на том же домене.
	handle_path /django-static/* {
		root * /srv/starpony-admin
		file_server
	}

	# Всё остальное — одностраничное приложение.
	handle {
		root * /srv/starpony

		# Имена собранных файлов содержат хеш содержимого: меняется файл —
		# меняется имя. Поэтому их можно кэшировать надолго.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# А index.html — никогда. Он единственный со стабильным именем,
		# и закэшированный им браузер будет вечно просить файлы прошлой сборки.
		@index path / /index.html
		header @index Cache-Control "no-cache"

		# Любой путь, которого нет на диске, отдаётся приложению: маршруты
		# вроде /suppliers существуют только внутри роутера, файла под них нет.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/starpony.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
