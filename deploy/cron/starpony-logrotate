# Ротация журнала синхронизации StarPony Insights.
# Установка: cp starpony-logrotate /etc/logrotate.d/starpony
#
# Без ротации файл растёт на несколько сотен мегабайт в год: синхронизация
# остатков идёт каждые 15 минут, то есть около 35 тысяч строк в год только
# от неё. На сервере, где считается каждый мегабайт, это заметно.
/var/log/starpony_sync.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}
